generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  password       String
  emailVerified  DateTime?
  image          String?
  roleId         String
  departmentId   String
  employeeId     String       @unique
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  accounts       Account[]
  sessions       Session[]
  access         UserAccess?
  userRoles      UserRole[]
  role             Role         @relation(fields: [roleId], references: [id])
  department       Department   @relation(fields: [departmentId], references: [id])
  departmentHeadOf Department[] @relation("DepartmentHead")
  activityHistory  ActivityHistory[]
  notifications    Notification[]
  reconciliationSavedPayments ReconciliationSavedPayment[] @relation("ReconciliationSavedBy")

  @@index([roleId])
  @@index([departmentId])
  @@map("users")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Department {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  headId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  head        User?     @relation("DepartmentHead", fields: [headId], references: [id])
  users       User[]
  budgetPlans BudgetPlan[]
  budgetRequests BudgetRequest[]
  paymentRequests PaymentRequest[]
  approvalSchemas ApprovalSchema[]
  reconciliationSavedPayments ReconciliationSavedPayment[]

  @@index([headId])
  @@map("departments")
}

model Role {
  id              String           @id @default(cuid())
  roleCode        String           @unique
  roleName        String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  userRoles       UserRole[]
  approvalLevels  ApprovalLevel[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model UserAccess {
  id              String   @id @default(cuid())
  userId          String   @unique
  menuAccess      Json
  activityAccess  Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_accesses")
}

model ApplicationSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("application_settings")
}

model FiscalYear {
  id        String   @id @default(cuid())
  year      Int      @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fiscal_years")
}

model Project {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  budgetPlans     BudgetPlan[]
  paymentRequests PaymentRequest[]

  @@map("projects")
}

model ApprovalSchema {
  id              String         @id @default(cuid())
  name            String
  type            String         // BudgetPlan | BudgetRequest | PaymentRequest
  period          String         @default("Unlimited") // Unlimited | Custom
  departmentId    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  department      Department     @relation(fields: [departmentId], references: [id])
  approvalLevels  ApprovalLevel[]
  budgetPlans     BudgetPlan[]
  budgetRequests  BudgetRequest[]
  paymentRequests PaymentRequest[]

  @@index([departmentId])
  @@map("approval_schemas")
}

model ApprovalLevel {
  id               String            @id @default(cuid())
  schemaId         String
  stepOrder        Int
  levelType        String            // Reviewer | Approver
  roleId           String
  parallelGroup    Int?              @default(0) // For parallel approval
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  schema           ApprovalSchema    @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  role             Role              @relation(fields: [roleId], references: [id])
  alternatingRules AlternatingRule[]

  @@index([schemaId])
  @@index([roleId])
  @@map("approval_levels")
}

model AlternatingRule {
  id             String       @id @default(cuid())
  approvalLevelId String
  userId         String
  startDate      DateTime
  endDate        DateTime
  status         String       @default("Active") // Active | Expired
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approvalLevel  ApprovalLevel @relation(fields: [approvalLevelId], references: [id], onDelete: Cascade)

  @@index([approvalLevelId])
  @@map("alternating_rules")
}

model BudgetPlan {
  id               String               @id @default(cuid())
  code             String               @unique
  subject          String
  description      String?              @db.Text
  fiscalYear       Int
  originOffice     String?
  departmentId     String
  projectId        String?
  requestorId      String?
  requestDate      DateTime
  status           String               @default("Draft") // Draft | Pending | Reviewed | Approved
  approvalSchemaId String?
  supportingDocs   Json?                // Array of file URLs
  coaId            String?              // account id from static JSON list
  categoryId       String?
  categoryKeyIndexId String?
  costCenterId     String?
  opexId           String?
  opexAllocationId String?
  opexType         String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  department       Department           @relation(fields: [departmentId], references: [id])
  project          Project?             @relation(fields: [projectId], references: [id])
  approvalSchema   ApprovalSchema?      @relation(fields: [approvalSchemaId], references: [id])
  category         CategoryMaster?      @relation(fields: [categoryId], references: [id])
  categoryKeyIndex CategoryKeyIndexMaster? @relation(fields: [categoryKeyIndexId], references: [id])
  costCenter       CostCenterMaster?    @relation(fields: [costCenterId], references: [id])
  opex             OpexMaster?          @relation(fields: [opexId], references: [id])
  opexAllocation   OpexAllocationMaster? @relation(fields: [opexAllocationId], references: [id])
  allocations      BudgetPlanAllocation[]
  budgetRequests   BudgetRequest[]

  @@index([departmentId])
  @@index([status])
  @@index([coaId])
  @@index([categoryId])
  @@index([categoryKeyIndexId])
  @@index([costCenterId])
  @@index([opexId])
  @@index([opexAllocationId])
  @@map("budget_plans")
}

model CategoryMaster {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  budgetPlans BudgetPlan[]

  @@map("category_masters")
}

model CategoryKeyIndexMaster {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  budgetPlans BudgetPlan[]

  @@map("category_key_index_masters")
}

model CostCenterMaster {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  budgetPlans BudgetPlan[]

  @@map("cost_center_masters")
}

model OriginOfficeMaster {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  address    String?
  officeType String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
  @@map("origin_office_masters")
}

model OpexMaster {
  id          String      @id @default(cuid())
  name        String      @unique
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  budgetPlans BudgetPlan[]

  @@map("opex_masters")
}

model OpexAllocationMaster {
  id          String      @id @default(cuid())
  name        String      @unique
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  budgetPlans BudgetPlan[]

  @@map("opex_allocation_masters")
}

model BudgetPlanAllocation {
  id          String     @id @default(cuid())
  budgetPlanId String
  month       Int        // 1-12
  allocation  Decimal    @db.Decimal(18, 2)
  budgetPlan  BudgetPlan @relation(fields: [budgetPlanId], references: [id], onDelete: Cascade)

  @@unique([budgetPlanId, month])
  @@index([budgetPlanId])
  @@map("budget_plan_allocations")
}

model BudgetRequest {
  id               String                 @id @default(cuid())
  code             String                 @unique
  budgetPlanId     String
  subject          String
  description      String?                @db.Text
  fiscalYear       Int
  departmentId     String
  requestorId      String?
  requestDate      DateTime
  status           String                 @default("Draft") // Draft | Pending | Approved
  totalAmount      Decimal                @default(0) @db.Decimal(18, 2)
  vatPercent       Decimal                @default(11) @db.Decimal(5, 2)
  vatAmount        Decimal                @default(0) @db.Decimal(18, 2)
  whtPercent       Decimal                @default(2) @db.Decimal(5, 2)
  whtAmount        Decimal                @default(0) @db.Decimal(18, 2)
  invoiceAmount    Decimal                @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal                @default(0) @db.Decimal(18, 2)
  approvalSchemaId String?
  notes            String?                @db.Text
  supportingDocs   Json?
  category         String?
  categoryKeyIndex String?
  costCenter       String?
  coa              String?
  type             String?                // OPEX etc
  opexAllocation   String?
  opexType         String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  budgetPlan       BudgetPlan             @relation(fields: [budgetPlanId], references: [id])
  department       Department             @relation(fields: [departmentId], references: [id])
  approvalSchema   ApprovalSchema?        @relation(fields: [approvalSchemaId], references: [id])
  lineItems        BudgetRequestLineItem[]
  allocations      BudgetRequestAllocation[]
  reconciliationSavedPayments ReconciliationSavedPayment[]
  dataMartStagingRows        DataMartStagingRow[]
  paymentRequests            PaymentRequest[]

  @@index([budgetPlanId])
  @@index([departmentId])
  @@index([status])
  @@map("budget_requests")
}

/// Permohonan pembayaran — alur approval internal Workxpace (eksekusi/pembukuan di Confins tetap terpisah).
model PaymentRequest {
  id               String           @id @default(cuid())
  code             String           @unique
  subject          String
  description      String?          @db.Text
  fiscalYear       Int
  originOffice     String?
  departmentId     String
  projectId        String?
  budgetRequestId  String?
  requestorId      String?
  requestDate      DateTime
  status           String           @default("Draft") // Draft | Pending | Reviewed | Approved | Revision | Declined
  /** Grand total to pay (invoice − WHT); mirrors budget request semantics. */
  amount           Decimal          @db.Decimal(18, 2)
  totalAmount      Decimal          @default(0) @db.Decimal(18, 2)
  vatPercent       Decimal          @default(11) @db.Decimal(5, 2)
  vatAmount        Decimal          @default(0) @db.Decimal(18, 2)
  whtPercent       Decimal          @default(2) @db.Decimal(5, 2)
  whtAmount        Decimal          @default(0) @db.Decimal(18, 2)
  invoiceAmount    Decimal          @default(0) @db.Decimal(18, 2)
  currency         String           @default("IDR")
  payeeName        String
  paymentPurpose   String?          @db.Text
  notes            String?          @db.Text
  supportingDocs   Json?
  category         String?
  categoryKeyIndex String?
  costCenter       String?
  coa              String?
  type             String?
  opexAllocation   String?
  opexType         String?
  approvalSchemaId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  department       Department       @relation(fields: [departmentId], references: [id])
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  budgetRequest    BudgetRequest?   @relation(fields: [budgetRequestId], references: [id], onDelete: SetNull)
  approvalSchema   ApprovalSchema?  @relation(fields: [approvalSchemaId], references: [id])
  lineItems        PaymentRequestLineItem[]

  @@index([departmentId])
  @@index([projectId])
  @@index([budgetRequestId])
  @@index([status])
  @@map("payment_requests")
}

model PaymentRequestLineItem {
  id               String         @id @default(cuid())
  paymentRequestId String
  item             String
  qty              Int
  unitPrice        Decimal        @db.Decimal(18, 2)
  subtotal         Decimal        @db.Decimal(18, 2)
  deduction        Decimal        @default(0) @db.Decimal(18, 2)
  total            Decimal        @db.Decimal(18, 2)
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([paymentRequestId])
  @@map("payment_request_line_items")
}

/// Baris staging untuk laporan Data Mart: kolom terindeks untuk query cepat + JSON fallback untuk field Confins yang berubah-ubah.
model DataMartStagingRow {
  id                           String   @id @default(cuid())
  reconciliationSavedPaymentId String   @unique @map("reconciliation_saved_payment_id")

  confinsPaymentDocId          String   @map("confins_payment_doc_id")
  budgetRequestId              String   @map("budget_request_id")

  fiscalYear                   Int      @map("fiscal_year")
  month                        Int
  period                       String
  quarter                      Int

  budgetRequestCode            String   @map("budget_request_code")
  budgetPlanCode               String?  @map("budget_plan_code")
  budgetRequestSubject         String?  @map("budget_request_subject") @db.Text
  expenseCategory              String?  @map("expense_category")
  categoryKeyIndex             String?  @map("category_key_index")
  costCenter                   String?  @map("cost_center")
  accountNumberCoa             String?  @map("account_number_coa")
  opexType                     String?  @map("opex_type")
  opexAllocation               String?  @map("opex_allocation")
  budgetRequestType            String?  @map("budget_request_type")
  projectCode                  String?  @map("project_code")

  departmentId                 String?  @map("department_id")
  departmentName               String?  @map("department_name")
  originOffice                 String?  @map("origin_office")
  divisionName                 String?  @map("division_name")

  requestorName                String?  @map("requestor_name")

  incomingReferenceId          String   @map("incoming_reference_id")
  voucherNumber                String?  @map("voucher_number")
  paymentDescription           String?  @map("payment_description") @db.Text
  paymentSource                String?  @map("payment_source")
  glAccountCode                String?  @map("gl_account_code")
  glAccountName                String?  @map("gl_account_name")
  paidAmount                   Decimal  @map("paid_amount") @db.Decimal(18, 2)
  expectedAmount               Decimal  @map("expected_amount") @db.Decimal(18, 2)
  currencyCode                 String?  @map("currency_code")

  businessRole                 String?  @map("business_role")
  activityCode                 String?  @map("activity_code")
  subActivityCode              String?  @map("sub_activity_code")
  activityLabel                String?  @map("activity_label") @db.Text
  subActivityLabel             String?  @map("sub_activity_label") @db.Text
  vendorName                   String?  @map("vendor_name")
  interfaceId                  String?  @map("interface_id")
  paymentRequestNo             String?  @map("payment_request_no")

  dataInterfaceSource          String?  @map("data_interface_source")
  expenseTypeFp                String?  @map("expense_type_fp")
  journalNo                    String?  @map("journal_no")
  voucherEgl                   String?  @map("voucher_egl")
  invoiceNo                    String?  @map("invoice_no")
  invoiceDate                  DateTime? @map("invoice_date")
  paymentRequestDate           DateTime? @map("payment_request_date")
  requestedByEmail             String?  @map("requested_by_email")
  projectName                  String?  @map("project_name")
  budgetRequestApprovedAt      DateTime? @map("budget_request_approved_at")
  planAmount                   Decimal? @map("plan_amount") @db.Decimal(18, 2)
  costDriverMetric             Decimal? @map("cost_driver_metric") @db.Decimal(18, 4)
  costPerUnit                  Decimal? @map("cost_per_unit") @db.Decimal(18, 6)

  confinsPayloadRaw            Json     @map("confins_payload_raw")
  budgetRequestSnapshot        Json     @map("budget_request_snapshot")

  matchType                    String   @map("match_type")
  savedAt                      DateTime @map("saved_at")

  reconciliationSavedPayment ReconciliationSavedPayment @relation(fields: [reconciliationSavedPaymentId], references: [id], onDelete: Cascade)
  budgetRequest              BudgetRequest              @relation(fields: [budgetRequestId], references: [id], onDelete: Cascade)

  @@index([fiscalYear, month])
  @@index([budgetRequestId])
  @@index([departmentId])
  @@index([originOffice])
  @@index([vendorName])
  @@index([savedAt])
  @@index([expenseCategory])
  @@index([categoryKeyIndex])
  @@index([projectCode])
  @@index([invoiceNo])
  @@map("data_mart_staging")
}

model ReconciliationSavedPayment {
  id                   String   @id @default(cuid())
  confinsPaymentDocId  String   @unique @map("confins_payment_doc_id")
  budgetRequestId      String   @map("budget_request_id")
  matchType            String
  incomingReferenceId  String   @map("incoming_reference_id")
  paidAmount           Decimal  @map("paid_amount") @db.Decimal(18, 2)
  expectedAmount       Decimal  @map("expected_amount") @db.Decimal(18, 2)
  fiscalYear           Int      @map("fiscal_year")
  month                Int
  departmentId         String?  @map("department_id")
  voucherNumber        String?  @map("voucher_number")
  paymentDescription   String?  @map("payment_description") @db.Text
  paymentSource        String?  @map("payment_source")
  glAccountCode        String?  @map("gl_account_code")
  glAccountName        String?  @map("gl_account_name")
  savedByUserId        String   @map("saved_by_user_id")
  savedAt              DateTime @default(now()) @map("saved_at")

  budgetRequest BudgetRequest @relation(fields: [budgetRequestId], references: [id], onDelete: Cascade)
  department    Department?   @relation(fields: [departmentId], references: [id])
  savedBy       User          @relation("ReconciliationSavedBy", fields: [savedByUserId], references: [id])
  dataMartStaging DataMartStagingRow?

  @@index([fiscalYear, month])
  @@index([budgetRequestId])
  @@index([savedAt])
  @@map("reconciliation_saved_payments")
}

model BudgetRequestAllocation {
  id              String        @id @default(cuid())
  budgetRequestId String
  year            Int
  month           Int           // 1-12
  allocation      Decimal       @db.Decimal(18, 2)
  budgetRequest   BudgetRequest @relation(fields: [budgetRequestId], references: [id], onDelete: Cascade)

  @@unique([budgetRequestId, year, month])
  @@index([budgetRequestId])
  @@index([year, month])
  @@map("budget_request_allocations")
}

model BudgetRequestLineItem {
  id             String        @id @default(cuid())
  budgetRequestId String
  item           String
  qty            Int
  unitPrice      Decimal       @db.Decimal(18, 2)
  subtotal       Decimal       @db.Decimal(18, 2)
  deduction      Decimal       @default(0) @db.Decimal(18, 2)
  total          Decimal       @db.Decimal(18, 2)
  months         Json?         // Array of month numbers
  budgetRequest  BudgetRequest @relation(fields: [budgetRequestId], references: [id], onDelete: Cascade)

  @@index([budgetRequestId])
  @@map("budget_request_line_items")
}

model ActivityHistory {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  entityId   String
  entityCode String?
  action     String
  details    Json
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("activity_histories")
}
