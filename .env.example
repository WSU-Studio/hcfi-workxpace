DATABASE_URL="postgresql://user:password@localhost:5432/workxpace?schema=public"
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Microsoft Entra ID (Azure AD) SSO — optional.
# Leave blank to disable SSO and only allow Credentials login.
# When enabling, all three values are required and the redirect URI
#   {NEXTAUTH_URL}/api/auth/callback/azure-ad
# must be registered on the App Registration in Entra (exact-match).
AZURE_APPLICATION_ID=""
AZURE_TENANT_ID=""
AZURE_CLIENT_SECRET=""

# Comma-separated list of Entra security group Object IDs (GUIDs) that are
# allowed to sign in via SSO. Matched against the `groups` claim in the ID
# token.
#   - Empty/unset → unrestricted: any authenticated Entra user can sign in.
#   - Non-empty   → only members of at least one listed group can sign in.
# Auto-provision happens on first login for authorized users; non-members
# are rejected with AccessDenied.
# When using non-empty values, App Registration must have:
#   Token Configuration → Add groups claim → Security groups → Group ID
# enabled in Entra. Otherwise the token has no `groups` claim and ALL users
# are rejected (fail-closed).
# Format: "a1b2c3d4-1234-5678-90ab-cdef12345678, e5f6g7h8-9012-3456-..."
AZURE_ALLOWED_GROUP_IDS=""

# Public mirror flag (true/false) — controls the SSO button on the login page.
# Must be in sync with AZURE_* above. Public because client components
# cannot read server-only env vars at render time.
NEXT_PUBLIC_AZURE_AD_SSO_ENABLED="false"

# Deployment tenant label (optional). Used for tenant-specific UI customisations.
# Example: hyundaicapital enables compact Budget Request detail view.
NEXT_PUBLIC_DEPLOYMENT_TENANT=""

# Explicit override for compact BR detail (approval grid + subject on page; rest in modal).
# When true, overrides tenant default. Other offices: leave unset or false.
NEXT_PUBLIC_BR_DETAIL_COMPACT_VIEW="false"

# Enable verbose [SSO] logging in the signIn callback. Off by default so
# production logs stay clean. Turn on temporarily when debugging SSO issues:
# logs the email, groups-claim shape, allowlist size, and auth decision.
# Does NOT log secrets or full tokens.
SSO_DEBUG="false"

# Bearer token for scheduled cron endpoints (Confins employee sync).
# Must match GitHub Secret `CRON_SECRET` when using Option A (GitHub Actions).
# Same value is used for Option B (server crontab). Generate with: openssl rand -base64 32
CRON_SECRET=""

# Supporting document uploads:
# - local      → simpan di `.data/` (dev localhost, tanpa AWS)
# - s3/unset   → production bucket Hyundai (AWS_* wajib diisi)
FILE_STORAGE=local
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""


SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=noreply@email.com
SMTP_PASS=password
SMTP_FROM=noreply@email.com